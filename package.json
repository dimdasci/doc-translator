{
	"name": "doc-translate",
	"version": "1.0.0",
	"description": "CLI tool for translating markdown documents using Anthropic API",
	"type": "module",
	"main": "dist/index.js",
	"bin": {
		"doc-translate": "dist/index.js"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsx src/index.ts",
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"check": "biome check .",
		"clean": "rm -rf dist"
	},
	"keywords": ["cli", "translation", "markdown", "anthropic"],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@anthropic-ai/sdk": "^0.27.0",
		"chalk": "^5.3.0",
		"commander": "^12.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.10.2",
		"typescript": "^5.7.2",
		"tsx": "^4.19.1"
	}
}
